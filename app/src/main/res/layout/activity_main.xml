<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/rail"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:background="@color/rail_bg"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal">
                    <ImageButton
                        android:id="@+id/btnRailExpand"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_rail_btn"
                        android:contentDescription="@string/cd_expand"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/icon_gray"
                        android:padding="12dp" />
                </FrameLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/railAvatars"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal">
                    <ImageButton
                        android:id="@+id/btnFullscreen"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_rail_btn"
                        android:contentDescription="@string/cd_fullscreen"
                        android:src="@drawable/ic_fullscreen"
                        app:tint="@color/icon_gray"
                        android:padding="12dp" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal">
                    <ImageButton
                        android:id="@+id/btnRailAdd"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_rail_add"
                        android:contentDescription="@string/cd_add"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/blue"
                        android:padding="12dp" />
                </FrameLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/chat_bg">
                <FrameLayout
                    android:id="@+id/webContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <ScrollView
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:background="@color/chat_bg"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp">
                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_mtile"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="m"
                            android:textColor="@color/m_blue"
                            android:textSize="33sp"
                            android:textStyle="bold|italic"
                            android:alpha="0.5" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/empty_title"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/empty_sub"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp" />
                        <Button
                            android:id="@+id/btnEmptyAdd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_blue_btn"
                            android:paddingLeft="30dp"
                            android:paddingRight="30dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/empty_add"
                            android:textColor="#FFFFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            style="@style/UiButton.Primary"
                            android:minHeight="52dp"
                            android:gravity="center"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </ScrollView>
                <FrameLayout
                    android:id="@+id/splash"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/splash_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="24dp">
                        <TextView
                            android:id="@+id/splashTile"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_mtile"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="m"
                            android:textColor="@color/m_blue"
                            android:textSize="27sp"
                            android:textStyle="bold|italic" />
                        <TextView
                            android:id="@+id/splashName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:ellipsize="end" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/splash_sub"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp"
                            android:gravity="center" />
                        <ProgressBar
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginTop="14dp"
                            android:indeterminateTint="@color/blue" />
                    </LinearLayout>
                </FrameLayout>
                <ScrollView
                    android:id="@+id/errorOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:background="@color/chat_bg"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp">
                        <TextView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_mtile"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="!"
                            android:textColor="@color/error"
                            android:textSize="33sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/errorTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/error_title"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp" />
                        <TextView
                            android:id="@+id/errorMsg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/error_hint"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp" />
                        <Button
                            android:id="@+id/btnRetry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_blue_btn"
                            android:paddingLeft="34dp"
                            android:paddingRight="34dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/error_retry"
                            android:textColor="#FFFFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            style="@style/UiButton.Primary"
                            android:minHeight="52dp"
                            android:gravity="center"
                            app:backgroundTint="@null" />
                        <Button
                            style="@style/UiButton"
                            android:id="@+id/btnErrorConfig"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/error_config" />
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/drawerContent"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/drawer_bg"
            android:fitsSystemWindows="true"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drawer_title"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:accessibilityHeading="true" />
                    <TextView
                        android:id="@+id/accCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
                <ImageButton
                    android:id="@+id/btnCollapse"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_rail_btn"
                    android:contentDescription="@string/cd_collapse"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/icon_gray"
                    android:padding="12dp" />
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search">
                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/icon_gray" />
                <EditText
                    android:id="@+id/drawerSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="11dp"
                    android:paddingStart="40dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_dim"
                    android:textSize="15sp"
                    android:minHeight="52dp"
                    android:singleLine="true"
                    android:importantForAutofill="no" />
                <ImageButton
                    android:id="@+id/searchClear"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_rail_btn"
                    android:src="@drawable/ic_close"
                    android:contentDescription="@string/search_clear"
                    app:tint="@color/icon_gray"
                    android:visibility="gone" />
            </FrameLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/accountList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:padding="10dp" />
            <LinearLayout
                android:id="@+id/btnAddAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_addcard"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:focusable="true"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginTop="8dp">
                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_addplus">
                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_add"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/blue" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_account"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/add_account_sub"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.drawerlayout.widget.DrawerLayout>
    <View
        android:id="@+id/edgeSwipe"
        android:layout_width="16dp"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
