<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/configRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:focusable="true" android:focusableInTouchMode="true"
    android:background="@color/bg">
    <LinearLayout style="@style/UiConfigContainer"
        android:layout_height="match_parent" android:layout_gravity="center_horizontal"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
            <ImageButton android:id="@+id/cfgBack" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_rail_btn" android:padding="12dp"
                android:contentDescription="@string/cd_back" android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_primary" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView style="@style/UiLabel" android:text="@string/config_title" android:textSize="20sp"
                    android:accessibilityHeading="true" />
                <TextView android:id="@+id/cfgAccountName" style="@style/UiHint"
                    android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <ScrollView android:id="@+id/configScroll" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="20dp"
            android:scrollbars="vertical" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout style="@style/UiCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/cfgTile" android:layout_width="56dp" android:layout_height="56dp"
                            android:background="@drawable/bg_mtile" android:gravity="center"
                            android:includeFontPadding="false" android:text="m" android:textColor="@color/m_blue"
                            android:textSize="28sp" android:textStyle="bold|italic"
                            android:importantForAccessibility="no" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                            <TextView style="@style/UiLabel" android:text="@string/config_identity"
                                android:textSize="17sp" android:accessibilityHeading="true" />
                            <TextView style="@style/UiHint" android:layout_marginTop="4dp"
                                android:text="@string/config_identity_hint" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView style="@style/UiLabel" android:layout_marginTop="20dp"
                        android:text="@string/config_avatar" />
                    <EditText android:id="@+id/cfgAvatar" style="@style/UiField"
                        android:inputType="text" android:hint="@string/config_avatar_hint" />
                    <TextView style="@style/UiLabel" android:layout_marginTop="18dp"
                        android:text="@string/config_name" />
                    <EditText android:id="@+id/cfgName" style="@style/UiField"
                        android:inputType="textCapSentences" android:hint="@string/config_name_hint" />
                    <TextView style="@style/UiLabel" android:layout_marginTop="18dp"
                        android:text="@string/config_tags" />
                    <EditText android:id="@+id/cfgTags" style="@style/UiField" android:inputType="text"
                        android:hint="@string/config_tags_hint" />
                    <TextView style="@style/UiHint" android:layout_marginTop="8dp"
                        android:text="@string/config_tags_note" />
                </LinearLayout>
                <LinearLayout style="@style/UiCard" android:layout_marginTop="16dp">
                    <TextView style="@style/UiLabel" android:text="@string/config_network" android:textSize="17sp"
                        android:accessibilityHeading="true" />
                    <TextView style="@style/UiHint" android:layout_marginTop="8dp"
                        android:text="@string/config_network_hint" />
                    <TextView style="@style/UiLabel" android:layout_marginTop="18dp"
                        android:text="@string/config_proxy" />
                    <EditText android:id="@+id/cfgProxy" style="@style/UiField"
                        android:inputType="textUri" android:imeOptions="actionDone"
                        android:hint="@string/config_proxy_ph" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="12dp" android:baselineAligned="false"
                        android:gravity="fill_vertical">
                        <Button android:id="@+id/cfgProxyDetect" style="@style/UiButton"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:text="@string/config_proxy_detect" />
                        <Button android:id="@+id/cfgProxyTest" style="@style/UiButton"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="10dp"
                            android:text="@string/config_proxy_test" />
                    </LinearLayout>
                    <TextView style="@style/UiHint" android:layout_marginTop="12dp"
                        android:text="@string/config_proxy_hint" />
                    <LinearLayout android:id="@+id/cfgStatusBox" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_search" android:padding="12dp" android:visibility="gone">
                        <ProgressBar android:id="@+id/cfgProxyProgress" android:layout_width="20dp"
                            android:layout_height="20dp" android:layout_marginEnd="10dp"
                            android:indeterminateTint="@color/blue" android:visibility="gone"
                            android:importantForAccessibility="no" />
                        <TextView android:id="@+id/cfgProxyStatus" style="@style/UiHint" android:layout_width="0dp"
                            android:layout_weight="1" android:accessibilityLiveRegion="polite" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <Button android:id="@+id/cfgSave" style="@style/UiButton.Primary" android:layout_width="match_parent"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp" android:layout_marginBottom="16dp"
            android:minHeight="52dp" android:text="@string/config_save" android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
